# =============================================================================
# SentinelX — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=SentinelX
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Database ---
# SQLite (development default):
DATABASE_URL=sqlite:///./sentinelx.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://sentinelx:changeme@localhost:5432/sentinelx

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# --- CORS ---
# Comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Agent Configuration ---
AGENT_SERVER_URL=http://localhost:8000
AGENT_DEVICE_ID=dev-endpoint-001
AGENT_API_TOKEN=CHANGE_ME
AGENT_LOG_LEVEL=INFO
AGENT_MONITORING_MODE=MONITOR_ONLY
# Comma-separated paths
AGENT_PROTECTED_PATHS=
AGENT_TRUSTED_PATHS=
